{
  "name": "checklist-map",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "tsx --test src/domain/backup.test.ts src/domain/walkthrough.test.ts src/data.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0-alpha-2026-07-29",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
